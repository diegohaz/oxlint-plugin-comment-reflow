{
  "name": "oxlint-plugin-comment-reflow",
  "version": "0.2.1",
  "description": "Syntax-aware comment wrapping and safe trailing-comment placement for Oxlint.",
  "keywords": [
    "comments",
    "formatter",
    "jsdoc",
    "oxlint",
    "oxlint-plugin"
  ],
  "homepage": "https://github.com/diegohaz/oxlint-plugin-comment-reflow#readme",
  "bugs": {
    "url": "https://github.com/diegohaz/oxlint-plugin-comment-reflow/issues"
  },
  "license": "MIT",
  "author": "Diego Haz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegohaz/oxlint-plugin-comment-reflow.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "scripts": {
    "build": "rolldown -c",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "fix": "pnpm run lint:fix && pnpm run format",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && vitest run",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm test",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only && oxfmt CHANGELOG.md package.json pnpm-lock.yaml",
    "release": "changeset publish",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.81.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "@types/node": "24.13.4",
    "lefthook": "2.1.12",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "rolldown": "1.2.7",
    "rolldown-plugin-dts": "0.28.5",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^24.18.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.3.4"
}
